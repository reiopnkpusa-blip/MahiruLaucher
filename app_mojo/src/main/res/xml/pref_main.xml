<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:key="">

    <git.artdeell.mojo.prefs.BackButtonPreference
        app:iconSpaceReserved="false" />

    <PreferenceCategory
        android:title="MAHIRU • PERSONALIZATION"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:key="startup_animation"
            android:title="@string/preference_startup_animation_title"
            android:summary="@string/preference_startup_animation_description"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />

        <ListPreference
            android:key="local_skin_model"
            android:title="Local skin model"
            android:summary="Choose Classic (4-pixel arms) or Slim (3-pixel arms) for your imported skin."
            android:entries="@array/mahiru_skin_model_entries"
            android:entryValues="@array/mahiru_skin_model_values"
            android:defaultValue="classic"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="GAME CONFIGURATION"
        app:iconSpaceReserved="false">

        <Preference
            android:key="video_screen_setting"
            android:title="@string/preference_video_title"
            android:summary="@string/preference_video_description"
            android:fragment="git.artdeell.mojo.prefs.screens.LauncherPreferenceVideoFragment"
            android:icon="@drawable/ic_px_image" />

        <Preference
            android:key="control_screen_setting"
            android:title="@string/preference_control_title"
            android:summary="@string/preference_control_description"
            android:fragment="git.artdeell.mojo.prefs.screens.LauncherPreferenceControlFragment"
            android:icon="@drawable/ic_px_gamepad" />

        <Preference
            android:key="java_screen_setting"
            android:title="@string/preference_java_title"
            android:summary="@string/preference_java_description"
            android:fragment="git.artdeell.mojo.prefs.screens.LauncherPreferenceJavaFragment"
            android:icon="@drawable/ic_px_java" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="ADVANCED OPTIONS"
        app:iconSpaceReserved="false">

        <Preference
            android:key="misc_screen_setting"
            android:title="@string/preference_misc_title"
            android:summary="@string/preference_misc_description"
            android:fragment="git.artdeell.mojo.prefs.screens.LauncherPreferenceMiscellaneousFragment"
            android:icon="@drawable/ic_px_alt_sliders" />

        <Preference
            android:key="experimental_screen_setting"
            android:title="@string/preference_experimental_title"
            android:summary="@string/preference_experimental_description"
            android:fragment="git.artdeell.mojo.prefs.screens.LauncherPreferenceExperimentalFragment"
            android:icon="@drawable/ic_px_experiment" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="LANGUAGE &amp; NOTIFICATIONS"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:title="@string/preference_force_english_title"
            android:key="force_english"
            android:summary="@string/preference_force_english_description"
            android:icon="@drawable/ic_px_translate"
            app:iconSpaceReserved="false" />

        <Preference
            android:title="@string/preference_ask_for_notification_title"
            android:summary="@string/preference_ask_for_notification_description"
            android:key="notification_permission_request"
            android:icon="@drawable/ic_px_bell" />

    </PreferenceCategory>

</PreferenceScreen>
